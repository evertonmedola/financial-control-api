# Application
NODE_ENV=development
PORT=3000

# Database (Postgres — matches docker-compose.yml's `db` service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=financial_control
DB_PASSWORD=change-me-locally
DB_NAME=financial_control

# JWT (access token: short-lived, stateless — Plan 01)
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m

# JWT (refresh token: DB-backed, revocable, opaque random value — not a
# signed JWT, so no secret is needed here; see env.validation.ts)
JWT_REFRESH_EXPIRES_IN=7d

# CORS (consumed starting Plan 02) — comma-separated list of allowed origins, never "*"
ALLOWED_ORIGINS=http://localhost:3000
